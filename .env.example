DATABASE_URL=postgresql://postgres:postgres@localhost:5432/terrascope
API_PORT=3001
WEB_PORT=5173
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=terrascope
SARVAM_API_KEY=your-sarvam-api-key
SARVAM_MODEL=sarvam-105b
PYTHON_BIN=.venv/bin/python
PYTHON_ENGINE_URL=http://127.0.0.1:8000
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key
VITE_GOOGLE_MAPS_MAP_ID=your-google-map-id
SENTINEL_HUB_CLIENT_ID=your-sentinel-hub-client-id
SENTINEL_HUB_CLIENT_SECRET=your-sentinel-hub-client-secret

# Optional project-managed native PostgreSQL (initialized cluster required)
# LOCAL_PG_BIN=/path/to/postgres/bin
# LOCAL_PG_DATA=.local/postgres-data

# Optional: allow phones/tablets on the same trusted Wi-Fi to open the frontend
# WEB_HOST=0.0.0.0
